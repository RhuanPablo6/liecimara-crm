# ─────────────────────────────────────────────────────────────
# Liecimara Ads CRM — variáveis de ambiente
# Copie para .env e preencha. NUNCA versione o .env real.
# ─────────────────────────────────────────────────────────────

# Ambiente: homolog | production
APP_ENV=homolog
NODE_ENV=development

# Banco
DATABASE_URL=postgresql://crm:crm@localhost:5432/liecimara_crm?schema=public

# API
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
WEB_ORIGIN=http://localhost:3000

# Autenticação (gere com: openssl rand -base64 48)
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
JWT_TTL_SECONDS=43200

# Chave de criptografia das credenciais de integração (32 bytes em base64)
# Gere com: openssl rand -base64 32
CREDENTIALS_ENCRYPTION_KEY=

# ── Meta / WhatsApp ──────────────────────────────────────────
META_GRAPH_VERSION=v23.0
# App Secret do app Meta (usado para validar X-Hub-Signature-256)
META_APP_SECRET=
# Token escolhido por você e informado no painel de webhooks da Meta
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Usuário administrador inicial (seed)
SEED_ADMIN_EMAIL=admin@clinica.local
SEED_ADMIN_PASSWORD=troque-esta-senha

# Worker
WORKER_POLL_INTERVAL_MS=1000
WORKER_CONCURRENCY=4
META_SYNC_CRON_MINUTES=60

# Regra: após quantos dias sem lead aberto um contato antigo gera novo lead
LEAD_REOPEN_AFTER_DAYS=30

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:4000
