{
  "name": "liecimara-ads-crm",
  "private": true,
  "version": "0.1.0",
  "description": "CRM de rastreamento de leads de anúncios Meta → WhatsApp para a clínica Liecimara",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "test": "pnpm --filter @liecimara/api test",
    "typecheck": "pnpm -r typecheck",
    "db:migrate": "pnpm --filter @liecimara/api prisma:migrate",
    "db:seed": "pnpm --filter @liecimara/api prisma:seed"
  }
}
