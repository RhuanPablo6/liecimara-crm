// ─────────────────────────────────────────────────────────────
// Liecimara Ads CRM — modelo de dados
// Valores monetários em centavos (Int) para evitar erros de ponto flutuante.
// IDs da Meta (anúncio, conjunto, campanha) são armazenados como texto,
// sem chave estrangeira obrigatória: um lead pode chegar com referência a um
// anúncio que ainda não foi sincronizado da Meta Marketing API.
// ─────────────────────────────────────────────────────────────

generator client {
  // Gerador novo: cliente em TypeScript dentro de src/, motor de consultas em WASM
  // importado estaticamente (empacota sem arquivos extras na Vercel/serverless) e
  // driver `pg` via @prisma/adapter-pg (sem binário Rust).
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  engineType             = "client"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Acesso ───────────────────────────────────────────────────

enum Role {
  ADMIN
  MANAGER
  RECEPTIONIST
  VIEWER
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(RECEPTIONIST)
  active       Boolean  @default(true)
  /// Telas liberadas (ex.: ["agenda","leads"]). Nulo = permissões do perfil. Administrador vê tudo.
  screens      Json?
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("users")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ── Contatos, conversas e mensagens ─────────────────────────

model Contact {
  id                String    @id @default(cuid())
  waId              String?   @unique // número no formato do WhatsApp (ex.: 5511999999999)
  bsuid             String?   @unique // business-scoped user id (usernames do WhatsApp)
  name              String?
  profileName       String?
  // Já era contato/paciente antes do CRM (importado via histórico/contatos)
  preExisting       Boolean   @default(false)
  // Etiqueta "da carteira" definida à mão (null = automática: já comprou → carteira)
  walletPatient     Boolean?
  firstSeenAt       DateTime
  lastMessageAt     DateTime?
  removedFromAppAt  DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([lastMessageAt])
  @@map("contacts")
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageSource {
  CUSTOMER     // enviada pelo paciente
  BUSINESS_APP // enviada pela recepção no app WhatsApp Business (echo)
  CLOUD_API    // enviada pela API
  HISTORY      // importada do histórico do app
}

model Conversation {
  id            String   @id @default(cuid())
  contactId     String
  startedAt     DateTime
  lastMessageAt DateTime
  // Mensagem que abriu a conversa veio de anúncio?
  openedByAdMetaId String?
  createdAt     DateTime @default(now())

  @@index([contactId, startedAt])
  @@map("conversations")
}

model Message {
  id             String           @id @default(cuid())
  waMessageId    String           @unique
  contactId      String
  conversationId String?
  direction      MessageDirection
  source         MessageSource
  type           String
  body           String?
  occurredAt     DateTime // carimbo do dispositivo/WhatsApp
  receivedAt     DateTime @default(now()) // quando o CRM recebeu
  status         String?
  hasAdReferral  Boolean  @default(false)

  @@index([contactId, occurredAt])
  @@index([occurredAt])
  @@map("messages")
}

// ── Anúncios (espelho da Meta Marketing API) ─────────────────

model Campaign {
  metaId    String   @id
  name      String
  status    String?
  objective String?
  // Conta de anúncios (sem "act_"), veiculação efetiva e orçamento (centavos) vindos da Meta
  accountId           String?
  effectiveStatus     String?
  dailyBudgetCents    Int?
  lifetimeBudgetCents Int?
  stopTime            DateTime?
  updatedAt DateTime @updatedAt

  @@map("campaigns")
}

model AdSet {
  metaId         String   @id
  campaignMetaId String
  name           String
  status         String?
  effectiveStatus     String?
  dailyBudgetCents    Int?
  lifetimeBudgetCents Int?
  updatedAt      DateTime @updatedAt

  @@index([campaignMetaId])
  @@map("ad_sets")
}

model Ad {
  metaId         String   @id
  adSetMetaId    String
  campaignMetaId String
  name           String
  status         String?
  // Código curto (ex.: "U1") usado na mensagem pronta do anúncio para a recepção
  // identificar a origem quando não há referência oficial do WhatsApp.
  code           String?  @unique
  // Procedimento que o anúncio divulga (definido no CRM): usado no financeiro por procedimento.
  procedureId    String?
  effectiveStatus String?
  updatedAt      DateTime @updatedAt

  @@index([campaignMetaId])
  @@index([adSetMetaId])
  @@map("ads")
}

model AdInsightDaily {
  id                       String   @id @default(cuid())
  adMetaId                 String
  date                     DateTime @db.Date
  spendCents               Int
  impressions              Int
  clicks                   Int
  // Métrica da Meta: onsite_conversion.messaging_conversation_started_7d
  // Critério da Meta, NÃO equivalente a lead único do CRM.
  metaMessagingConversationsStarted Int @default(0)
  currency                 String   @default("BRL")
  syncedAt                 DateTime @default(now())

  @@unique([adMetaId, date])
  @@index([date])
  @@map("ad_insights_daily")
}

// ── Leads e atribuição ───────────────────────────────────────

enum LeadStage {
  NEW        // Novo
  CONTACTED  // Em atendimento
  SCHEDULED  // Agendado
  ATTENDED   // Compareceu / avaliação feita
  WON        // Venda realizada
  LOST       // Perdido
}

enum AttributionConfidence {
  OFFICIAL_REFERRAL // Confirmada por referência oficial (referral do webhook)
  MANUAL            // Informada manualmente
  UNKNOWN           // Origem desconhecida
}

enum LostReason {
  PRICE
  NO_RESPONSE
  CHOSE_COMPETITOR
  NOT_A_CANDIDATE
  SCHEDULE_CONFLICT
  JUST_RESEARCHING
  OTHER
}

model Procedure {
  id                String  @id @default(cuid())
  name              String  @unique
  defaultPriceCents Int?
  active            Boolean @default(true)
  /// Dias até a paciente precisar voltar (ex.: Botox 120). Nulo = sem lembrete de retorno.
  returnDays        Int?

  @@map("procedures")
}

model Lead {
  id                    String                @id @default(cuid())
  contactId             String
  stage                 LeadStage             @default(NEW)
  procedureInterestId   String?
  ownerId               String?
  attributionConfidence AttributionConfidence @default(UNKNOWN)
  adMetaId              String?
  adSetMetaId           String?
  campaignMetaId        String?
  // Evidência que sustenta a atribuição atual
  attributionEvidenceId String?
  // Origem quando não veio de anúncio: REFERRAL, INSTAGRAM, GOOGLE, RETURNING, WALK_IN, OTHER
  originType            String?
  // Detalhe da origem (ex.: "indicada pela Maria Souza")
  originNote            String?
  lostReason            LostReason?
  lostNote              String?
  openedAt              DateTime // instante (WhatsApp) da primeira mensagem do lead
  firstResponseAt       DateTime?
  closedAt              DateTime?
  lastActivityAt        DateTime
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  @@index([contactId, closedAt])
  @@index([stage])
  @@index([adMetaId])
  @@index([openedAt])
  @@map("leads")
}

enum EvidenceKind {
  OFFICIAL_REFERRAL
  MANUAL
}

model AttributionEvidence {
  id           String       @id @default(cuid())
  leadId       String
  contactId    String
  messageId    String?      // waMessageId que trouxe a referência
  kind         EvidenceKind
  sourceType   String?      // "ad" | "post" (referral.source_type)
  sourceId     String?      // referral.source_id (ID do anúncio quando source_type = ad)
  sourceUrl    String?
  ctwaClid     String?
  headline     String?
  adMetaId     String?
  occurredAt   DateTime
  recordedById String?
  note         String?
  raw          Json?
  createdAt    DateTime     @default(now())

  @@index([leadId])
  @@index([adMetaId])
  @@map("attribution_evidence")
}

model LeadStageHistory {
  id        String     @id @default(cuid())
  leadId    String
  fromStage LeadStage?
  toStage   LeadStage
  userId    String?
  reason    String?
  at        DateTime   @default(now())

  @@index([leadId])
  @@map("lead_stage_history")
}

// ── Comercial ────────────────────────────────────────────────

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  CANCELED
  NO_SHOW
  ATTENDED
}

model Appointment {
  id            String            @id @default(cuid())
  leadId        String
  procedureId   String?
  scheduledFor  DateTime
  /// Duração prevista (minutos) para a agenda
  durationMin   Int               @default(60)
  notes         String?
  // Resposta da paciente pelo link da mensagem: CONFIRMED | CANCELED | RESCHEDULE
  patientResponse   String?
  patientResponseAt DateTime?
  patientNote       String?
  // Pedido de remarcação já tratado pela recepção
  rescheduleHandled Boolean  @default(false)
  /// Confirmação automática pelo WhatsApp (YCloud)
  confirmationSentAt   DateTime?
  confirmationMessageId String?
  confirmationError    String?
  status        AppointmentStatus @default(SCHEDULED)
  cancelReason  String?
  createdById   String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([leadId])
  @@index([scheduledFor])
  @@map("appointments")
}

enum SaleStatus {
  ACTIVE
  CANCELED
}

model Sale {
  id                    String                @id @default(cuid())
  leadId                String
  procedureId           String
  amountCents           Int
  soldAt                DateTime
  status                SaleStatus            @default(ACTIVE)
  // Previsão de recebimento do saldo em aberto (contas a receber)
  dueAt                 DateTime?
  // Fotografia da atribuição no momento da venda (auditável)
  attributionConfidence AttributionConfidence
  adMetaId              String?
  campaignMetaId        String?
  createdById           String?
  createdAt             DateTime              @default(now())

  @@index([leadId])
  @@index([soldAt])
  @@index([adMetaId])
  @@map("sales")
}

enum PaymentMethod {
  PIX
  CREDIT_CARD
  DEBIT_CARD
  CASH
  BANK_TRANSFER
  OTHER
}

model Payment {
  id           String        @id @default(cuid())
  saleId       String
  amountCents  Int
  method       PaymentMethod
  installments Int           @default(1)
  paidAt       DateTime
  createdById  String?
  createdAt    DateTime      @default(now())

  @@index([saleId])
  @@map("payments")
}

model ProcedurePerformed {
  id          String   @id @default(cuid())
  leadId      String
  saleId      String?
  procedureId String
  performedAt DateTime
  createdById String?
  createdAt   DateTime @default(now())

  @@index([leadId])
  @@index([performedAt])
  @@map("procedures_performed")
}

model Reminder {
  id           String    @id @default(cuid())
  leadId       String
  dueAt        DateTime
  note         String
  assignedToId String?
  doneAt       DateTime?
  createdById  String?
  createdAt    DateTime  @default(now())

  @@index([dueAt, doneAt])
  @@map("reminders")
}

// ── Integrações, eventos e fila ─────────────────────────────

enum IntegrationProvider {
  WHATSAPP_CLOUD_API
  WHATSAPP_COEXISTENCE_PARTNER
  META_MARKETING
}

enum IntegrationEnvironment {
  HOMOLOG
  PRODUCTION
}

enum ConnectionStatus {
  PENDING
  CONNECTED
  DEGRADED
  DISCONNECTED
  ERROR
}

model IntegrationConnection {
  id                   String                 @id @default(cuid())
  provider             IntegrationProvider
  environment          IntegrationEnvironment @default(HOMOLOG)
  status               ConnectionStatus       @default(PENDING)
  label                String?
  wabaId               String?
  phoneNumberId        String?
  displayPhoneNumber   String?
  adAccountId          String?
  coexistence          Boolean                @default(false)
  encryptedCredentials String? // AES-256-GCM
  partnerConfig        Json?
  webhookStatus        String? // OK | NO_EVENTS | SIGNATURE_FAILURES
  lastWebhookAt        DateTime?
  lastSyncAt           DateTime?
  permissionsDiagnostic Json?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  @@unique([provider, environment])
  @@map("integration_connections")
}

model IntegrationError {
  id           String   @id @default(cuid())
  connectionId String?
  provider     IntegrationProvider
  code         String
  message      String
  context      Json?
  createdAt    DateTime @default(now())

  @@index([provider, createdAt])
  @@map("integration_errors")
}

enum InboundEventStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
  DEAD
  IGNORED
}

model InboundEvent {
  id          String             @id @default(cuid())
  provider    IntegrationProvider
  dedupKey    String             @unique
  kind        String
  payload     Json
  occurredAt  DateTime
  receivedAt  DateTime           @default(now())
  status      InboundEventStatus @default(RECEIVED)
  attempts    Int                @default(0)
  lastError   String?
  processedAt DateTime?

  @@index([status, receivedAt])
  @@map("inbound_events")
}

enum JobStatus {
  PENDING
  RUNNING
  DONE
  FAILED
  DEAD
}

model Job {
  id          String    @id @default(cuid())
  type        String
  payload     Json
  status      JobStatus @default(PENDING)
  dedupKey    String?   @unique
  attempts    Int       @default(0)
  maxAttempts Int       @default(8)
  runAt       DateTime  @default(now())
  lockedAt    DateTime?
  lockedBy    String?
  lastError   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, runAt])
  @@map("jobs")
}

// ── Compras de insumos da clínica ───────────────────────────

model SupplyPurchase {
  id            String   @id @default(cuid())
  /// SUPPLY = compra de insumos · RENTAL = aluguel de aparelho (Ultraformer, Lavieen...)
  kind          String   @default("SUPPLY")
  purchasedAt   DateTime
  supplier      String?
  /// [{ name, quantity }]
  items         Json
  totalCents    Int
  /// PIX | CREDIT_CARD | DEBIT_CARD | BOLETO | CASH | BANK_TRANSFER | OTHER
  paymentMethod String
  /// 1 = à vista
  installments  Int      @default(1)
  /// Vencimento da 1ª parcela (as demais, mês a mês). Nulo = data da compra (à vista) ou +1 mês (parcelado)
  firstDueAt    DateTime?
  /// Quantas parcelas já foram pagas (em ordem)
  paidInstallments Int   @default(0)
  notes         String?
  createdById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([purchasedAt])
  @@map("supply_purchases")
}

// ── Despesas da clínica (aluguel, energia, condomínio...) ──

model Expense {
  id            String   @id @default(cuid())
  /// Data de vencimento/pagamento (dia civil de São Paulo, gravado ao meio-dia local)
  date          DateTime
  category      String
  description   String?
  amountCents   Int
  paymentMethod String?
  paid          Boolean  @default(true)
  createdById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([date])
  @@map("expenses")
}

// ── Configurações (taxas da maquininha, saldo em conta...) ──

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("settings")
}

// ── Contas de anúncios da Meta ─────────────────────────────

model AdAccount {
  id           String   @id // sem "act_"
  name         String
  currency     String?
  timezoneName String?
  status       Int?
  updatedAt    DateTime @updatedAt

  @@map("ad_accounts")
}

// ── Retornos: registro de contato / adiamento com a paciente ─

model RecallAction {
  id          String    @id @default(cuid())
  contactId   String
  /// Ciclo a que a ação se refere (ex.: "<procedimento>:<data da última vez>" ou "reactivation:<data>")
  dueKey      String
  kind        String // CONTACTED | SNOOZED | DISMISSED
  until       DateTime?
  note        String?
  createdById String?
  createdAt   DateTime  @default(now())

  @@index([contactId])
  @@map("recall_actions")
}

/// Período em que a agenda da doutora está fechada (férias, congresso...).
model AgendaBlock {
  id          String   @id @default(cuid())
  startAt     DateTime
  endAt       DateTime
  allDay      Boolean  @default(true)
  reason      String
  note        String?
  createdById String?
  createdAt   DateTime @default(now())

  @@index([startAt, endAt])
  @@map("agenda_blocks")
}

/// Orçamento apresentado à paciente na consulta (fica no histórico dela).
model Quote {
  id            String    @id @default(cuid())
  number        Int       @unique @default(autoincrement())
  contactId     String
  leadId        String?
  status        String    @default("OPEN") // OPEN | APPROVED | REJECTED
  items         Json
  discountCents Int       @default(0)
  totalCents    Int
  validUntil    DateTime
  paymentTerms  String?
  notes         String?
  saleIds       Json?
  decidedAt     DateTime?
  createdById   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([contactId])
  @@index([createdAt])
  @@map("quotes")
}

// ── Prontuário estético ──

/// Anamnese ou termo de consentimento. Depois de assinado, o conteúdo não muda (hash guardado).
model ClinicalForm {
  id               String    @id @default(cuid())
  contactId        String
  kind             String // ANAMNESIS | CONSENT
  title            String
  procedureId      String?
  /// Anamnese: { sections: [{ title, items: [{ q, a, detail?, alert? }] }] } · Termo: { text }
  content          Json
  status           String    @default("PENDING") // PENDING | SIGNED
  /// Autorização de uso de imagem marcada pela paciente: NONE | INTERNAL | MARKETING
  imageUse         String?
  signerName       String?
  signerDocument   String?
  /// PNG (data URL) da assinatura feita no celular
  signature        String?
  signedAt         DateTime?
  signedIp         String?
  signedUserAgent  String?
  contentHash      String?
  createdById      String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([contactId])
  @@map("clinical_forms")
}

/// Registro de cada sessão: produtos (com lote), áreas tratadas e evolução.
model ClinicalSession {
  id           String   @id @default(cuid())
  contactId    String
  procedureId  String?
  performedAt  DateTime
  /// [{ name, lot, quantity, unit }]
  products     Json
  areas        String?
  notes        String?
  createdById  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([contactId])
  @@map("clinical_sessions")
}

/// Foto de antes/depois. Guardada no banco (privada, só via API com permissão).
model ClinicalPhoto {
  id          String   @id @default(cuid())
  contactId   String
  sessionId   String?
  takenAt     DateTime
  stage       String // BEFORE | AFTER | FOLLOWUP
  angle       String?
  caption     String?
  mime        String
  data        Bytes
  thumb       Bytes
  width       Int
  height      Int
  sizeBytes   Int
  createdById String?
  createdAt   DateTime @default(now())

  @@index([contactId])
  @@index([sessionId])
  @@map("clinical_photos")
}
